# ============================================
# FlowAI .gitignore
# ============================================

# Dependencies
node_modules/
**/node_modules/
.npm/
.yarn/
.pnpm-store/

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.der
*.keystore
*.jks
id_rsa*
id_ed25519*
credentials.json
credentials*.json
service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json
.secrets/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# Build artifacts
dist/
build/
.next/
.out/
.cache/
.parcel-cache/
.turbo/
.vite/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/
jest-test-results*

# OS & editor files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.suo
*.user

# Debug & runtime data
*.pid
*.pid.lock
*.seed

# Docker (local overrides only; compose file itself is committed)
docker-compose.override.yml
docker-compose.*.local.yml

# Deploy platforms
.vercel/
.netlify/
.railway/

# Backups & temp
*.bak
*.tmp
*.temp
